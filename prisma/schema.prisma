generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum SetupType {
  PS5
  PS4
  GAMING_PC
}

enum SetupStatus {
  AVAILABLE
  ACTIVE
  RESERVED
  MAINTENANCE
  EXPIRED
}

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  ONLINE
  WALK_IN
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  CASH
  UPI
  CARD
  MEMBERSHIP_CREDIT
}

enum PaymentType {
  TOKEN
  FULL
  WALK_IN
  SESSION_EXTENSION
  MEMBERSHIP
  REFUND
}

enum MembershipType {
  MONTHLY
  HOURS
  VIP
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  SESSION_ENDING
  SESSION_EXPIRED
  PAYMENT_SUCCESS
  UPCOMING_BOOKING
  SYSTEM
}

enum NotificationChannel {
  DASHBOARD
  EMAIL
  SMS
  WHATSAPP
}

enum TournamentStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

model User {
  id                      String                       @id @default(cuid())
  name                    String?
  email                   String?                      @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  phone                   String?
  role                    Role                         @default(CUSTOMER)
  loyaltyPoints           Int                          @default(0)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  accounts                Account[]
  sessions                Session[]
  bookings                Booking[]
  setupSessions           SetupSession[]               @relation("CustomerSetupSessions")
  sessionsCreated         SetupSession[]               @relation("SessionCreatedBy")
  sessionsEnded           SetupSession[]               @relation("SessionEndedBy")
  payments                Payment[]
  memberships             Membership[]
  notifications           Notification[]
  invoices                Invoice[]
  expensesCreated         Expense[]                    @relation("ExpenseCreatedBy")
  tournamentRegistrations TournamentRegistration[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Setup {
  id             String         @id @default(cuid())
  stationCode    String         @unique
  name           String
  type           SetupType
  hourlyPrice    Decimal        @db.Decimal(10, 2)
  status         SetupStatus    @default(AVAILABLE)
  floor          String         @default("Main Floor")
  displayOrder   Int            @default(0)
  bufferMinutes  Int            @default(10)
  isBookable     Boolean        @default(true)
  specs          Json?
  lastSeenAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bookings       Booking[]
  setupSessions  SetupSession[]

  @@index([type, status])
  @@index([displayOrder])
  @@map("setups")
}

model Booking {
  id              String         @id @default(cuid())
  reference       String         @unique
  setupId         String
  customerId      String
  setupType       SetupType
  status          BookingStatus  @default(PENDING)
  source          BookingSource  @default(ONLINE)
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  bufferMinutes   Int            @default(10)
  priceTotal      Decimal        @db.Decimal(10, 2)
  tokenAmount     Decimal        @default(0) @db.Decimal(10, 2)
  paidAmount      Decimal        @default(0) @db.Decimal(10, 2)
  paymentStatus   PaymentStatus  @default(PENDING)
  paymentMode     PaymentMethod?
  notes           String?
  qrPayload       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  setup           Setup          @relation(fields: [setupId], references: [id], onDelete: Restrict)
  customer        User           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  setupSession    SetupSession?
  payments        Payment[]
  invoices        Invoice[]

  @@index([setupId, startTime, endTime])
  @@index([customerId, createdAt])
  @@index([status, startTime])
  @@map("bookings")
}

model SetupSession {
  id                 String        @id @default(cuid())
  setupId            String
  customerId         String?
  bookingId          String?       @unique
  status             SessionStatus @default(ACTIVE)
  startedAt          DateTime
  endsAt             DateTime
  endedAt            DateTime?
  pausedAt           DateTime?
  totalPausedSeconds Int           @default(0)
  ratePerHour        Decimal       @db.Decimal(10, 2)
  billedAmount       Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount         Decimal       @default(0) @db.Decimal(10, 2)
  notes              String?
  createdById        String?
  endedById          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  setup              Setup         @relation(fields: [setupId], references: [id], onDelete: Restrict)
  customer           User?         @relation("CustomerSetupSessions", fields: [customerId], references: [id], onDelete: SetNull)
  booking            Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy          User?         @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  endedBy            User?         @relation("SessionEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  payments           Payment[]
  invoices           Invoice[]

  @@index([setupId, status])
  @@index([customerId, startedAt])
  @@index([status, endsAt])
  @@map("setup_sessions")
}

model Payment {
  id                  String        @id @default(cuid())
  bookingId           String?
  sessionId           String?
  membershipId        String?
  userId              String?
  invoiceNumber       String        @unique
  providerOrderId     String?
  providerPaymentId   String?
  providerSignature   String?
  amount              Decimal       @db.Decimal(10, 2)
  currency            String        @default("INR")
  status              PaymentStatus @default(PENDING)
  method              PaymentMethod
  type                PaymentType
  metadata            Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  booking             Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  setupSession        SetupSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  membership          Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoice             Invoice?

  @@index([bookingId])
  @@index([sessionId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  paymentId     String?       @unique
  bookingId     String?
  sessionId     String?
  userId        String?
  status        InvoiceStatus @default(ISSUED)
  subtotal      Decimal       @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  lineItems     Json
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  setupSession  SetupSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([issuedAt])
  @@map("invoices")
}

model MembershipPlan {
  id              String          @id @default(cuid())
  name            String
  type            MembershipType
  price           Decimal         @db.Decimal(10, 2)
  includedMinutes Int             @default(0)
  discountPercent Int             @default(0)
  priorityBooking Boolean         @default(false)
  maxDailyMinutes Int?
  isActive        Boolean         @default(true)
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  memberships     Membership[]

  @@index([type, isActive])
  @@map("membership_plans")
}

model Membership {
  id               String           @id @default(cuid())
  userId           String
  planId           String
  status           MembershipStatus @default(ACTIVE)
  startsAt         DateTime
  endsAt           DateTime
  remainingMinutes Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments         Payment[]

  @@index([userId, status])
  @@index([endsAt])
  @@map("memberships")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  type      NotificationType
  channel   NotificationChannel @default(DASHBOARD)
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([type, createdAt])
  @@map("notifications")
}

model AnalyticsSnapshot {
  id                 String   @id @default(cuid())
  date               DateTime @unique
  dailyRevenue       Decimal  @default(0) @db.Decimal(10, 2)
  onlineRevenue      Decimal  @default(0) @db.Decimal(10, 2)
  walkInRevenue      Decimal  @default(0) @db.Decimal(10, 2)
  occupancyPercent   Decimal  @default(0) @db.Decimal(5, 2)
  activeMinutes      Int      @default(0)
  totalBookings      Int      @default(0)
  bookingConversions Int      @default(0)
  peakHour           Int?
  mostUsedSetupId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([date])
  @@map("analytics")
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  incurredAt  DateTime @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([incurredAt])
  @@map("expenses")
}

model Tournament {
  id            String                   @id @default(cuid())
  title         String
  game          String
  startsAt      DateTime
  endsAt        DateTime?
  entryFee      Decimal                  @default(0) @db.Decimal(10, 2)
  prizePool     Decimal                  @default(0) @db.Decimal(10, 2)
  maxPlayers    Int
  status        TournamentStatus         @default(UPCOMING)
  description   String?
  rules         String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  registrations TournamentRegistration[]

  @@index([status, startsAt])
  @@map("tournaments")
}

model TournamentRegistration {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  gamerTag     String
  paid         Boolean    @default(false)
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([userId])
  @@map("tournament_registrations")
}
